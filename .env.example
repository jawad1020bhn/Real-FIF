# NO API KEYS. This harness is keyless by design.
# Copy to .env only if you want to override local binary paths.
# The CLI --lang flag always wins over LANG.

PYTHON=.venv/bin/python
LANG=ar                        # ar | en
RENDERER=auto                  # auto | hyperframes | pillow
ALIGN_BACKEND=from-json        # from-json | whisperx | faster-whisper
HF_HUB_OFFLINE=1               # keep offline until models/ is pre-seeded
TRANSFORMERS_OFFLINE=1
ASR_DEVICE=cpu                 # cpu | cuda
ASR_COMPUTE_TYPE=int8          # int8 | float16 (float16 needs GPU)
HYPERFRAMES_TELEMETRY=off
HYPERFRAMES_NO_UPDATE_CHECK=1
DO_NOT_TRACK=1

# Optional binary overrides; scripts resolve pinned npm binaries automatically.
# FFMPEG_PATH=
# FFPROBE_PATH=
# HYPERFRAMES_FFMPEG_PATH=
# HYPERFRAMES_FFPROBE_PATH=
# HYPERFRAMES_BROWSER_PATH=
# CHROME_PATH=
# LD_LIBRARY_PATH=
